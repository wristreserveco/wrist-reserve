# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: Service role key (webhooks, chat history API). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL — required in production (checkout redirects, emails, webhooks).
# Production: https://wristreserve.co (no trailing slash). Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Payments — Wrist Reserve accepts only PayPal (cards via PayPal) and Crypto.
#   PayPal handles cards, PayPal balance + buyer protection.
#   NOWPayments handles BTC, ETH, USDT, USDC, LTC + 60 more.
# Both rails redirect to a hosted payment page — card data never touches us.
# -----------------------------------------------------------------------------

# PayPal — Developer dashboard → My Apps & Credentials → Live (or Sandbox)
#   PAYPAL_ENV: "sandbox" while you test, "live" once your business is enrolled.
#   Webhook: Apps → your app → Webhooks → add
#     https://www.wristreserve.co/api/webhooks/paypal
#   Subscribe to:
#     PAYMENT.CAPTURE.COMPLETED
#     PAYMENT.CAPTURE.DENIED
#     PAYMENT.CAPTURE.REFUNDED
#   Then paste the Webhook ID below (NOT the URL — the ID PayPal shows).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# NOWPayments — crypto (BTC, ETH, USDT-TRC20, USDC, LTC, ~60+ coins).
# Sign up: https://nowpayments.io  — Settings → API Keys
# Free, non-custodial, auto-conversion to your preferred payout currency.
# IPN secret: Settings → IPN → generate and paste the same value here.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# -----------------------------------------------------------------------------
# Shipping — Shippo (label printing + tracking)
# Sign up: https://goshippo.com  — Settings → API → API Tokens
# -----------------------------------------------------------------------------

# Use the test token (shippo_test_...) until you've confirmed labels look right,
# then swap to the live token (shippo_live_...).
SHIPPO_API_TOKEN=

# Webhook signing secret — Settings → Webhooks → create endpoint at
# https://www.wristreserve.co/api/webhooks/shippo and paste the secret here.
# Until set we accept all webhooks (useful for first-run testing).
SHIPPO_WEBHOOK_SECRET=

# Default ship-from address (printed on every label). All required.
SHIPPO_FROM_NAME=
SHIPPO_FROM_COMPANY=
SHIPPO_FROM_STREET1=
SHIPPO_FROM_STREET2=
SHIPPO_FROM_CITY=
SHIPPO_FROM_STATE=
SHIPPO_FROM_ZIP=
SHIPPO_FROM_COUNTRY=US
SHIPPO_FROM_PHONE=
SHIPPO_FROM_EMAIL=

# Default parcel dimensions (inches) and per-watch weight (ounces).
# Used at rate-fetch time. Admin can override per shipment in the panel later.
SHIPPO_DEFAULT_PARCEL_LENGTH_IN=8
SHIPPO_DEFAULT_PARCEL_WIDTH_IN=6
SHIPPO_DEFAULT_PARCEL_HEIGHT_IN=4
SHIPPO_DEFAULT_PARCEL_WEIGHT_OZ=16

# Auto-add carrier insurance up to the order's declared value (true/false).
SHIPPO_INSURANCE_AUTO=false

# Auto-require signature on delivery for orders ≥ this USD amount. Blank = off.
SHIPPO_SIGNATURE_REQUIRED_OVER_USD=500

# AUTO-SHIP: when true, the moment an order is marked paid (via PayPal capture,
# NOWPayments IPN, or admin "Mark paid"), we automatically fetch rates and buy
# the cheapest qualifying label with no human in the loop. Failures are logged
# silently to the order timeline; admin can still buy manually.
SHIPPO_AUTO_BUY=false
# Skip auto-buy if the cheapest rate exceeds this USD amount (safety cap).
# Blank = no cap.
SHIPPO_AUTO_BUY_MAX_USD=
# Optional: prefer this carrier when auto-buying (USPS, UPS, FedEx, DHL_EXPRESS).
# Falls back to cheapest if the preferred carrier isn't quoted.
SHIPPO_AUTO_BUY_PREFERRED_CARRIER=

# Optional: Telegram admin notifications (off by default — admin dashboard now
# has in-app realtime alerts with sound). Leave blank unless you want phone
# pushes in addition to the dashboard toast + badge.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
